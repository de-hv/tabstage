# Template for de-hv/homebrew-tap, filled in by .github/workflows/release.yml.
cask "tabstage" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/de-hv/tabstage-desktop/releases/download/@TAG@/Tabstage_#{version}_universal.dmg"
  name "Tabstage"
  desc "Groups of tabs that open in the browser you choose"
  homepage "https://de-hv.github.io/tabstage-desktop/"

  depends_on macos: ">= :catalina"

  app "Tabstage.app"

  # Not notarized yet: drop the quarantine flag so Gatekeeper lets it open.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/Tabstage.app"]
  end

  zap trash: [
    "~/Library/Application Support/io.github.de-hv.tabstage",
    "~/Library/Caches/io.github.de-hv.tabstage",
    "~/Library/WebKit/io.github.de-hv.tabstage",
  ]
end

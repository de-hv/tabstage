{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabstage",
  "identifier": "io.github.de-hv.tabstage",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "beforeBuildCommand": "npm run build -w ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tabstage",
        "width": 980,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Groups of tabs that open in the browser you choose",
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
